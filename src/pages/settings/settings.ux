<template>
  <div class="page" @swipe="handleSwipe">
    <image class="bg-image" src="/common/title_bg.jpg"></image>

    <!-- 顶部标题 -->
    <div class="header">
      <text class="header-title">系统设定</text>
    </div>

    <!-- 设置列表 -->
    <scroll scroll-y="true" class="list">
      <!-- 文字速度 -->
      <div class="card">
        <text class="card-label">文字速度</text>
        <text class="card-value">{{ settings.textSpeed }}ms</text>
      </div>
      <slider
        class="slider"
        min="20"
        max="100"
        step="5"
        value="{{ settings.textSpeed }}"
        @change="changeTextSpeed"
      ></slider>

      <!-- 文字大小 -->
      <div class="card">
        <text class="card-label">文字大小</text>
        <text class="card-value">{{ settings.textSize }}px</text>
      </div>
      <slider
        class="slider"
        min="10"
        max="30"
        step="1"
        value="{{ settings.textSize }}"
        @change="changeTextSize"
      ></slider>

      <!-- 自动播放间隔 -->
      <div class="card">
        <text class="card-label">自动播放间隔</text>
        <text class="card-value">{{ settings.autoPlayDelay }}ms</text>
      </div>
      <slider
        class="slider"
        min="500"
        max="3000"
        step="100"
        value="{{ settings.autoPlayDelay }}"
        @change="changeAutoPlayDelay"
      ></slider>

      <!-- 功能开关 -->
      <div class="card switch-row" @click="toggleBoldText">
        <text class="card-label">文字加粗</text>
        <image class="switch-img" src="/common/images/{{ settings.boldText ? 'Switch_ON' : 'Switch_OFF' }}.png"></image>
      </div>
      <div class="card switch-row" @click="toggleAutoSave">
        <text class="card-label">自动保存</text>
        <image class="switch-img" src="/common/images/{{ settings.autoSave ? 'Switch_ON' : 'Switch_OFF' }}.png"></image>
      </div>
      <div class="card switch-row" @click="toggleVibration">
        <text class="card-label">振动反馈</text>
        <image class="switch-img" src="/common/images/{{ settings.vibration ? 'Switch_ON' : 'Switch_OFF' }}.png"></image>
      </div>
    </scroll>

    <!-- 底部操作栏 -->
    <div class="footer">
      <div class="footer-btn" @click="saveSettings">
        <text class="footer-btn-text">保存</text>
      </div>
      <div class="footer-btn" @click="back">
        <text class="footer-btn-text">返回</text>
      </div>
    </div>

    <!-- 打字机预览 -->
    <div class="preview-box">
      <scroll scroll-y="true" class="preview-scroll" id="dialogueScroll">
        <text
          class="preview-text"
          style="font-size: {{ settings.textSize }}px; line-height: {{ settings.textSize * 1.3 }}px; font-weight: {{ settings.boldText ? 'bold' : 'normal' }};"
        >
          {{ displayText }}
        </text>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import {DEBUG, SETTINGS_KEY} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  data: {
    text: "「诅咒解开之后，那种事情应该也不会再发生了。」",
    displayText: "",
    currentCharIndex: 0,

    settings: {
      textSpeed: 40,
      textSize: 22,
      autoPlayDelay: 500,
      boldText: true,
      autoSave: true,
      darkMode: false,
      vibration: true
    }
  },

  onInit() {
    this.timer = null

    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        if (data) {
          try {
            const parsed = JSON.parse(data)
            Object.assign(this.settings, parsed)
          } catch (e) {}
        }
        this.showTypeWriterEffect()
      }
    })
  },

  showTypeWriterEffect() {
    if (this.timer) clearTimeout(this.timer)

    if (this.currentCharIndex === 0) {
      this.$element("dialogueScroll").scrollTo({ top: 0, behavior: "instant" })
    }

    if (this.currentCharIndex < this.text.length) {
      this.displayText += this.text.charAt(this.currentCharIndex)
      this.currentCharIndex++

      this.timer = setTimeout(() => {
        this.showTypeWriterEffect()
      }, this.settings.textSpeed)

      if (this.currentCharIndex % 5 === 0 && this.displayText.length > 20) {
        this.$element("dialogueScroll").scrollTo({ top: 9999, behavior: "instant" })
      }
    } else {
      this.timer = setTimeout(() => {
        this.currentCharIndex = 0
        this.displayText = ""
        this.showTypeWriterEffect()
      }, 2000)
    }
  },

  saveSettings() {
    vibrateShort()
    storage.set({
      key: SETTINGS_KEY,
      value: JSON.stringify(this.settings),
      success: () => { this.back() },
      fail: () => {}
    })
  },

  changeTextSpeed(e) {
    const value = e.progress !== undefined ? e.progress : e.value
    if (value !== undefined) this.settings.textSpeed = value
  },

  changeTextSize(e) {
    const value = e.progress !== undefined ? e.progress : e.value
    if (value !== undefined) this.settings.textSize = value
  },

  changeAutoPlayDelay(e) {
    const value = e.progress !== undefined ? e.progress : e.value
    if (value !== undefined) this.settings.autoPlayDelay = value
  },

  toggleBoldText() {
    this.settings.boldText = !this.settings.boldText
    vibrateShort()
  },

  toggleAutoSave() {
    this.settings.autoSave = !this.settings.autoSave
    vibrateShort()
  },

  toggleVibration() {
    this.settings.vibration = !this.settings.vibration
    vibrateShort()
  },

  handleSwipe() {},

  onDestroy() {
    if (this.timer) {
      clearTimeout(this.timer)
      this.timer = null
    }
  },

  back() {
    vibrateShort()
    router.back()
  }
}
</script>

