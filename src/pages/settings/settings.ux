  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  lines: -1;
  margin-top: 2px;
}

.slider {
  height: 32px;
  width: 100%;
  margin-bottom: 12px;
  selected-color: #0d6eff;
  block-color: #0d6eff;
  color: rgba(255, 255, 255, 0.3);
}

.switch-row {
  margin-bottom: 8px;
  flex-direction: row;
  justify-content: space-between;
}

.switch-img {
  width: 48px;
  height: 28px;
}

.footer {
  position: absolute;
  bottom: 130px;
  left: 12px;
  right: 12px;
  flex-direction: row;
  justify-content: center;
}

.footer-btn {
  flex: 1;
  height: 48px;
  margin: 0 6px;
  background-color: #0d6eff;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}

